@page "/home"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="home-header">

    <div class="home-header-top">
        <img src="clamshell_header.png" class="home-logo" />
        <div class="home-header-text">
            <h2>Project Clamshell</h2>
            <p>Created by Evan Whelan, James Hattenhauer, and Karaleena Dalton</p>
        </div>
    </div>

    <div class="home-content-row">
        <InfoBox>
            <h3>System Status</h3>
            <p>@statusText</p>
        </InfoBox>

        <div class="right-column">
            <InfoBox>
                <h3>Encryption</h3>
            </InfoBox>

            <div class="bottom-right-box">
                <InfoBox>
                    <p>Encrypted Using ChaCha20-Poly1305</p>
                    <p>XCHACHA20POLY1305_KEY=39F6AE55B5A83E007B4A8911AFF7A515725CF97711B0B3B51E324B03A313B2EC</p>
                    <p>XCHACHA20POLY1305_NONCE=0B9CCF526C1E460D084045649A513A615647AD3D2AB71EA6</p>
                </InfoBox>
            </div>

        </div>
           
    </div>
</div>

@code {
    private string statusText = "Checking...";
    protected override async Task OnInitializedAsync()
    {
        await CheckStatus();
    }

    private async Task CheckStatus()
    {
        try
        {
            var isLive = await Http.GetFromJsonAsync<bool>("http://tcpapi:5000/api/messages/status");

            statusText = isLive ? "Online":"Offline";
        }
        catch
        {
            statusText = "Offline";
        }
    }
}