@page "/home"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="home-header">

    <div class="home-header-top">
        <div class="home-header-text">
            <h2>Project Clamshell</h2>
        </div>
    </div>

    <div class="home-content-row">
        <InfoBox>
            <h3>System Status</h3>
            <p>@statusText</p>
        </InfoBox>

        <div class="right-column">
            <InfoBox>
                <h3>Encryption</h3>
            </InfoBox>

            <div class="bottom-right-box">
                <InfoBox>
                    <p>Encrypted Using: </p>
                    <p>ChaCha20-Poly1305</p>
                    @if (encryptionStatus != null)
                    {
                        <p>XCHACHA20POLY1305_KEY=</p>
                        <p>****************@encryptionStatus.Key</p>
                        <p>XCHACHA20POLY1305_NONCE=</p>
                        <p>****************@encryptionStatus.Nonce</p>
                    }
                </InfoBox>
            </div>

        </div>
           
    </div>
</div>

@code {
    private string statusText = "Checking...";

    private EncryptionStatus? encryptionStatus;
    protected override async Task OnInitializedAsync()
    {
        await CheckStatus();
    }

    private async Task CheckStatus()
    {
        try
        {
            var isLive = await Http.GetFromJsonAsync<bool>("http://tcpapi:5000/api/messages/status");

            statusText = isLive ? "Online":"Offline";
        }
        catch
        {
            statusText = "Offline";
        }
        try
        {
            encryptionStatus = await Http.GetFromJsonAsync<EncryptionStatus>("http://tcpapi:5000/api/messages/encryptionStatus");
        }
        catch
        {
            encryptionStatus = null;
        }
    }

    public class EncryptionStatus
    {
        public string? Key { get; set; }
        public string? Nonce { get; set; }
    }
}