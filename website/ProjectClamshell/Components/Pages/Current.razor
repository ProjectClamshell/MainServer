@page "/current"
@rendermode InteractiveServer
@inject HttpClient Http
@using ProjectClamshell.Models
@using System.Timers

<PageTitle>Current</PageTitle>

<div class="info-container">

    <div class="info-column">
        <div class="info-box">
            <h3>Validated</h3>
        </div>

        <div class="info-box">
            <h3>@infoValidated</h3>

            @if (infoValidated > 0)
            {
                if(latestvalidated != null)
                {
                    <div>
                        <strong>Latest Message:</strong> <br />
                        <strong>Id:</strong> @latestvalidated.Id <br />
                        <strong>Content:</strong> @latestvalidated.Content <br />
                        <strong>Received At:</strong> @latestvalidated.ReceivedAt <br />
                        <strong>PGN:</strong> @latestvalidated.PGN
                    </div>
                }
            }

        </div>
    </div>

    <div class="info-column">
        <div class="info-box">
            <h3>Signed</h3>
        </div>

        <div class="info-box">
            <h3>@infoSigned</h3>

            @if (infoSigned > 0)
            {
                if(latestsigned != null)
                {
                    <div>
                        <strong>Latest Message:</strong> <br />
                        <strong>Id:</strong> @latestsigned.Id <br />
                        <strong>Content:</strong> @latestsigned.Content <br />
                        <strong>Received At:</strong> @latestsigned.ReceivedAt <br />
                        <strong>PGN:</strong> @latestsigned.PGN
                    </div>
                }
            }


        </div>
    </div>

    <div class="info-column">
        <div class="info-box">
            <h3>Unvalidated</h3>
        </div>

        <div class="info-box">
            <h3>@infoCorrupted</h3>

            @if (infoCorrupted > 0)
            {
                if(latestcorrupted != null)
                {
                    <div>
                        <strong>Latest Message:</strong> <br />
                        <strong>Id:</strong> @latestcorrupted.Id <br />
                        <strong>Content:</strong> @latestcorrupted.Content <br />
                        <strong>Received At:</strong> @latestcorrupted.ReceivedAt <br />
                        <strong>PGN:</strong> @latestcorrupted.PGN
                    </div>
                }
            }

        </div>
    </div>

</div>

@code {
    private int infoValidated = 0;
    private int infoSigned = 0;
    private int infoCorrupted = 0;
    private Timer? refreshTimer;

    private List<Message> validatedMessages = new();
    private List<Message> signedMessages = new();
    private List<Message> unvalidatedMessages = new();
    private List<Message> corruptedMessages = new();

    private Message? latestvalidated;
    private Message? latestsigned;
    private Message? latestcorrupted;

    protected override async Task OnInitializedAsync()
    {
        await LoadCounts();

        refreshTimer = new Timer(3000);
        refreshTimer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(async () =>
            {
                await LoadCounts();
                StateHasChanged();
            });
        };
        refreshTimer.AutoReset = true;
        refreshTimer.Enabled = true;
    }

    private async Task LoadCounts()
    {
        try
        {
            validatedMessages = await Http.GetFromJsonAsync<List<Message>>("http://tcpapi:5000/api/messages/validated") ?? new();
            signedMessages = await Http.GetFromJsonAsync<List<Message>>("http://tcpapi:5000/api/messages/signed") ?? new();
            unvalidatedMessages = await Http.GetFromJsonAsync<List<Message>>("http://tcpapi:5000/api/messages/unvalidated") ?? new();
            corruptedMessages = new List<Message>();
            corruptedMessages.AddRange(unvalidatedMessages);

            infoValidated = validatedMessages.Count;
            infoSigned = signedMessages.Count;
            infoCorrupted = corruptedMessages.Count;

            latestvalidated = validatedMessages.OrderByDescending(m => m.ReceivedAt).FirstOrDefault();
            latestsigned = signedMessages.OrderByDescending(m => m.ReceivedAt).FirstOrDefault();
            latestcorrupted = corruptedMessages.OrderByDescending(m => m.ReceivedAt).FirstOrDefault();
        }
        catch
        {
            validatedMessages = new();
            signedMessages = new();
            corruptedMessages = new();

            infoValidated = -1;
            infoSigned = -1;
            infoCorrupted = -1;
        }
    }

    public class Message
    {
        public int Id { get; set; }
        public string? Content { get; set; }
        public DateTime ReceivedAt { get; set; }
        public string? PGN { get; set; }
    }

    public void Dispose()
    {
        refreshTimer?.Stop();
        refreshTimer?.Dispose();
    }

}
