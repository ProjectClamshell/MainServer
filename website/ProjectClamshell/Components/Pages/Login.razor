@page "/"
@page "/login"
@layout EmptyLayout
@using ProjectClamshell.ViewModels

@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<div class="row">
    <div class="col-lg-4 offset-lg-4 pt-4 pb-4">

        <EditForm Model="@Model" OnValidSubmit="Authenticate">

            <div class="mb-3 text-center">
                <img src="/clamshell_login.png"/>
            </div>

            <div class="mb-3">
                <label>User Name</label>
                <InputText class="form-control" @bind-Value="Model.UserName" />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <InputText type="password" class="form-control" @bind-Value="Model.Password" />
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Login</button>
            </div>

        </EditForm>

    </div>
</div>

@code {
    public LoginViewModel Model { get; set; } = new();

    private async Task Authenticate()
{
    try
    {
        var url = $"http://localhost:5000/api/messages/login/{Model.UserName}/{Model.Password}";

        var isValid = await Http.GetFromJsonAsync<bool>(url);

        if (isValid)
        {
            Navigation.NavigateTo("/home");
        }
        else
        {
            Console.WriteLine("Invalid login");
        }
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Error: {ex.Message}");
    }
}
}